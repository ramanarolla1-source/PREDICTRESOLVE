# ============================================================
# PredictResolve
# Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true

# ------------------------------------------------------------
# Flare Network
# ------------------------------------------------------------

# Example test environment:
# FLARE_NETWORK=coston2

FLARE_NETWORK=coston2

# RPC endpoint for the selected Flare network.
# Leave blank for the current demonstration-only repository.
FLARE_RPC_URL=

# Chain ID of the selected network.
FLARE_CHAIN_ID=

# ------------------------------------------------------------
# FDC / Web2Json
# ------------------------------------------------------------

# FDC configuration.
FDC_HUB_ADDRESS=

# Web2Json / verification configuration.
FDC_VERIFIER_ADDRESS=

# Optional endpoint used by a live integration.
FDC_API_URL=

# Source/API configuration.
PUBLIC_DATA_API_URL=
PUBLIC_DATA_API_KEY=

# ------------------------------------------------------------
# Confidential Compute / TEE
# ------------------------------------------------------------

# Production deployment should provide the appropriate
# Flare Confidential Compute / TEE configuration.

FCC_ENDPOINT=
FCC_APP_ID=
FCC_VERIFIER_ADDRESS=

# Identifier for the TEE environment.
TEE_ENVIRONMENT=demonstration

# ------------------------------------------------------------
# PredictResolve Settlement Contract
# ------------------------------------------------------------

PREDICTRESOLVE_SETTLEMENT_ADDRESS=

TRUST_RECEIPT_REGISTRY_ADDRESS=

# ------------------------------------------------------------
# FXRP
# ------------------------------------------------------------

# FXRP token contract used by the selected Flare environment.
FXRP_TOKEN_ADDRESS=

# Optional escrow / funding contract.
FXRP_ESCROW_ADDRESS=

# ------------------------------------------------------------
# Smart Account
# ------------------------------------------------------------

# Participant or authorized Smart Account.
SMART_ACCOUNT_ADDRESS=

# Never commit a real private key.
# Use a secure secret manager in production.
SMART_ACCOUNT_PRIVATE_KEY=

# ------------------------------------------------------------
# Trust Receipt Storage
# ------------------------------------------------------------

# Encrypted off-chain storage endpoint/reference.
TRUST_RECEIPT_STORAGE_URL=

# Encryption key reference for protected receipt storage.
# Production deployments should use a secure KMS/HSM.
TRUST_RECEIPT_ENCRYPTION_KEY=

# ------------------------------------------------------------
# AI / Source Intelligence
# ------------------------------------------------------------

# Optional live AI provider.
# Current prototype uses deterministic source assessments.
AI_PROVIDER=

AI_MODEL=

AI_API_KEY=

# ------------------------------------------------------------
# Resolution Configuration
# ------------------------------------------------------------

DEFAULT_RESOLUTION_RULE=PREDICTRESOLVE-MATCH-WINNER-V1

MINIMUM_SOURCE_SCORE=0.70

REQUIRE_SOURCE_VALIDATION=true

REQUIRE_FDC_VERIFICATION=true

REQUIRE_TEE_ATTESTATION=true

REQUIRE_TRUST_RECEIPT=true

# ------------------------------------------------------------
# Settlement Configuration
# ------------------------------------------------------------

# Prevent settlement when external sources disagree.
BLOCK_ON_SOURCE_CONFLICT=true

# Require finalized external events for the MVP.
REQUIRE_FINAL_EVENT=true

# Production deployments should enable actual transaction execution
# only after live contracts and verification are configured.
ENABLE_ONCHAIN_SETTLEMENT=false

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Never expose private prediction terms in logs.
REDACT_PRIVATE_INPUTS=true

# Never store private keys in source code or JSON data files.
REQUIRE_SECURE_KEY_STORAGE=true
